# /etc/caddy/Caddyfile on the podcast server (Oracle Cloud, Always Free). Installed by
# ops/oci/cloud-init.yaml on first boot; to change it later, see ops/oci/RUNBOOK.md.
# Two shows, two hostnames, one folder each under /var/www/podcast/, filled by
# `podcast/pod.py deploy` over rsync. Static files only. Added 2026-09-14.

(podcast_show) {
	encode gzip {
		match {
			header Content-Type text/*
			header Content-Type application/rss+xml*
			header Content-Type application/xml*
		}
	}
	@feed path /feed.xml
	header @feed {
		Content-Type "application/rss+xml; charset=utf-8"
		Cache-Control "public, max-age=300"
		defer
	}
	@mp3 path *.mp3
	header @mp3 {
		Content-Type "audio/mpeg"
		Cache-Control "public, max-age=604800"
		defer
	}
	header /art/* Cache-Control "public, max-age=604800"
	file_server {
		hide .rsync-partial
	}
}

podcast.age-of-abundance.org {
	root * /var/www/podcast/age-of-abundance
	import podcast_show
}

podcast.cocreations.com.au {
	root * /var/www/podcast/unfinished-cubby
	import podcast_show
}
